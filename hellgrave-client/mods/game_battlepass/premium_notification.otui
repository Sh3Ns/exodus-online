BattlePassActionButton < UIButton
  font: verdana-11px-rounded
  image-source: /images/ui/button_white
  image-color: #817d77
  image-border: 6
  height: 26
  padding: 4 12
  text-offset: 0 0
  text-align: center
  color: white
  change-cursor-image: true
  cursor: pointer

  $hover:
    image-color: #9a958e
    color: white

  $focus:
    image-color: #dfdfdf
    color: white

  $pressed:
    image-color: #6f6b65
    color: #ffffff

  $disabled:
    color: #9a9a9a

MainWindow
  id: waitingWindow
  text: Buy premium battlepass
  size: 300 250
  @onEscape: modules.game_battlepass.m_BattlepassFunctions.destroyHover()

  UIWidget
    anchors.top: parent.top
    anchors.horizontalcenter: parent.horizontalcenter
    size: 45 85
    image-source: images/Paid_Pass

  Label
    id: description
    anchors.top: prev.bottom
    anchors.bottom: next.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-wrap: true
    text-align: center

  BattlePassActionButton
    text: Cancel
    anchors.bottom: parent.bottom
    anchors.left: parent.horizontalcenter
    margin-left: 4
    size: 80 26
    @onClick: modules.game_battlepass.m_BattlepassFunctions.destroyHover()

  BattlePassActionButton
    text: Accept
    tooltip: I Accept if i already completed levels i cannot receive premium rewards of previous levels.
    anchors.bottom: prev.bottom
    anchors.right: prev.left
    margin-right: 8
    size: 80 26
    @onClick: modules.game_battlepass.m_BattlepassFunctions.acceptPremiumNotification()
