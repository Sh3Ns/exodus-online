BattlePassActionButton < UIButton
  font: verdana-11px-rounded
  image-source: /images/ui/button_white
  image-color: #817d77
  image-border: 6
  height: 26
  padding: 4 12
  text-offset: 0 0
  text-align: center
  color: white

  $hover:
    image-color: #9a958e
    color: white

  $focus:
    image-color: #dfdfdf
    color: white

  $disabled:
    color: #9a9a9a

MainWindow
  id: waitingWindow
  text: Premium battlepass notification
  size: 300 200
  @onEscape: modules.game_battlepass.m_BattlepassFunctions.destroyHover()

  UIWidget
    anchors.top: parent.top
    anchors.horizontalcenter: parent.horizontalcenter
    size: 45 85
    image-source: images/free_pass

  Label
    id: description
    anchors.top: prev.bottom
    anchors.bottom: next.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-wrap: true
    text-align: center
    text: Your 

  BattlePassActionButton
    text: Close
    anchors.bottom: parent.bottom
    anchors.horizontalcenter: parent.horizontalcenter
    size: 80 26
    @onClick: modules.game_battlepass.m_BattlepassFunctions.destroyHover()
