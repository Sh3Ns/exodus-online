BattlePassPanel < Panel
  background-color: #3e3a35
  border: 1 #5d564d

BattlePassActionButton < UIButton
  font: verdana-11px-rounded
  image-source: /images/ui/button_white
  image-color: #817d77
  image-border: 6
  height: 26
  padding: 4 12
  text-offset: 0 0
  text-align: center
  color: white
  change-cursor-image: true
  cursor: pointer

  $hover:
    image-color: #9a958e
    color: white

  $focus:
    image-color: #dfdfdf
    color: white

  $pressed:
    image-color: #6f6b65
    color: #ffffff

  $disabled:
    color: #9a9a9a

BattlePassLabel < Label
  anchors.top: prev.bottom
  anchors.left: parent.left
  anchors.right: parent.right
  height: 76
  text-align: center
  text-wrap: true
  font: verdana-11px-antialised

BattlePassItem < Item
  virtual: true

BattlePassReward < UIWidget
  anchors.top: prev.bottom
  anchors.left: parent.left
  anchors.right: parent.right
  height: 88
  image-source: /images/ui/item
  image-border: 6
  
  BattlePassPanel
    id: rewards
    anchors.horizontalcenter: parent.horizontalcenter
    anchors.verticalcenter: parent.verticalcenter
    margin-top: 2
    image-source: /images/ui/item
    layout:
      type: grid
      cell-size: 34 34
      flow: true

  UICreature
    id: outfit
    anchors.horizontalcenter: parent.horizontalcenter
    anchors.verticalcenter: parent.verticalcenter
    margin-top: 8
    image-source: /images/ui/item
    fixed-creature: 1.0
    size: 64 64
    phantom: true
    focusable: false

  UIWidget
    id: premium
    anchors.horizontalcenter: parent.horizontalcenter
    anchors.verticalcenter: parent.verticalcenter
    image-source: images/battlepass_premium
    size: 32 32

  UIWidget
    id: background
    anchors.fill: parent
    background-color: #000000AA
    font: verdana-11px-antialised
    text-align: center
    visible: false
    tooltip: Reward already sent to your mailbox.

  UIWidget
    id: premiumBackground
    anchors.fill: parent
    background-color: #000000AA
    font: verdana-11px-antialised
    text-align: center
    visible: false
    icon: images/battlepass_premium
    icon-size: 32 32
    icon-offset: 27 27
    tooltip: Reward available for premium battlepass only.
    
BattlePassQuestLabel < Label
  id: separator
  height: 38
  text-align: left
  text-offset: 12 4
  font: verdana-11px-antialised
  color: #FC4B00

BattlePassQuestEntry < BattlePassPanel
  height: 123
  margin-left: 4
  margin-right: 4
  margin-top: 4
  BattlePassActionButton
    id: shuffle
    anchors.top: parent.top
    anchors.left: parent.left
    margin: 8
    text: Shuffle
    font: verdana-11px-rounded
    size: 120 26
    @onClick: modules.game_battlepass.m_BattlepassFunctions.shuffleQuest(self:getParent())

  BattlePassActionButton
    id: completed
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin: 8
    text: Claim
    color: #AAFF00
    font: verdana-11px-rounded
    size: 120 26
    enabled: false
    @onClick: modules.game_battlepass.m_BattlepassFunctions.completeQuest(self:getParent())

  UIWidget
    id: questProgressBar
    anchors.verticalcenter: prev.verticalcenter
    anchors.left: shuffle.left
    anchors.right: prev.left
    margin-right: 13
    height: 28
    image-source: /images/ui/progresbar_empty_pass
    image-border: 2
    
    UIWidget
      id: bar
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      image-source: images/battlepassquestprogress
      margin: 2
        
    Label
      id: label
      anchors.fill: parent
      text-align: center
      font: verdana-11px-rounded

  Label
    id: questName
    anchors.left: prev.left
    anchors.right: parent.right
    anchors.top: shuffle.bottom
    margin-top: 8
    margin-left: 6
    height: 20
    color: #fbff00
    font: verdana-11px-antialised

  Label
    id: questDescription
    anchors.left: prev.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 6
    height: 16
    color: #ffae00
    font: verdana-11px-rounded
    
  Label
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.left: parent.left
    margin-top: 6
    margin-right: 12
    height: 26
    text-align: right
    font: verdana-11px-antialised  
    text: Reward
    
  Label
    anchors.top: prev.bottom
    anchors.right: prev.right
    anchors.left: parent.left
    height: 26
    text-align: right
    font: verdana-11px-antialised  
    text: Battlepass experience points
    
  Label
    id: questPoints
    anchors.top: prev.bottom
    anchors.right: prev.right
    anchors.left: parent.left
    height: 26
    color: #AAFF00
    text-align: right
    font: verdana-11px-antialised

  UIWidget
    id: background
    anchors.fill: parent
    background-color: #000000AA
    margin: 2
    font: verdana-11px-antialised
    text: ?
    text-align: center
    visible: false
    
BattlePassRewardContainer < BattlePassPanel
  width: 92

  Label
    id: id
    anchors.top: parent.top
    anchors.horizontalcenter: parent.horizontalcenter
    margin-top: 6
    height: 24
    font: verdana-11px-antialised

  BattlePassReward
    id: freeReward

  BattlePassReward
    id: premiumReward

  UIWidget
    id: progressBar
    anchors.verticalcenter: prev.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 18
    
    UIWidget
      id: bar
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      image-source: images/battlepass
      width: 1
      visible: false
    
HorizontalSeparator < UIWidget
  height: 14
  phantom: true
    
MainWindow
  id: battlepassWindow
  anchors.centerIn: parent
  size: 971 625
  phantom: false
  text: Battlepass
  font: sans-bold-16px
  text-offset: 0 4
  padding-bottom: 5
  @onEscape: modules.game_battlepass.m_BattlepassFunctions.destroy()

  BattlePassActionButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    size: 22 22
    margin-top: 17
    margin-right: 14
    padding: 0
    text-offset: 0 1
    text: X
    @onClick: modules.game_battlepass.m_BattlepassFunctions.destroy()

  BattlePassPanel
    id: infoPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 36
    margin-left: 12
    margin-right: 12
    height: 220

    BattlePassPanel
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      width: 208
    
      BattlePassLabel
        anchors.top: parent.top
        height: 24
        text: TIER
        margin-top: 6
        color: #ffae00

      HorizontalSeparator
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: -6
        margin-left: 8
        margin-right: 8
    
      BattlePassLabel
        tooltip: FREE REWARDS
        icon-source: images/free_pass
        icon-size: 45 85
        icon-offset: 82 0
        phantom: false

      HorizontalSeparator
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-left: 8
        margin-right: 8
    
      BattlePassLabel
        tooltip: PREMIUM REWARDS
        icon-source: images/Paid_Pass
        icon-size: 45 85
        icon-offset: 82 0
        phantom: false

      HorizontalSeparator
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: -4
        margin-left: 8
        margin-right: 8

    ScrollablePanel
      id: rewards
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      anchors.left: prev.right
      padding-left: 2
      padding-right: 2
      padding-bottom: 16
      horizontal-scrollbar: battlepassRewardsScrollBar
      layout:
        type: horizontalBox

    HorizontalScrollBar
      id: battlepassRewardsScrollBar
      anchors.bottom: prev.bottom
      anchors.right: prev.right
      anchors.left: prev.left
      step: 92
      pixels-scroll: true

  BattlePassPanel
    id: levelPanel
    anchors.top: prev.bottom
    anchors.left: prev.left
    anchors.right: prev.right
    margin-top: 8
    height: 64

    BattlePassPanel
      id: level
      anchors.left: parent.left
      anchors.verticalcenter: parent.verticalcenter
      margin-left: 8
      size: 48 48
      text-align: center
  
    UIWidget
      id: progressBar
      anchors.verticalcenter: parent.verticalcenter
      anchors.left: prev.right
      anchors.right: parent.right
      margin-left: 12
      margin-right: 60
      image-source: /images/ui/progresbar_empty_pass
      image-border: 8
      height: 32
      
      UIWidget
        id: bar
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        image-source: images/battlepassbar
        image-border: 4
        width: 0
        
      Label
        id: label
        anchors.fill: parent
        text-align: center
        font: verdana-11px-rounded

  ScrollablePanel
    id: questsPanel
    anchors.top: prev.bottom
    anchors.bottom: parent.bottom
    anchors.left: prev.left
    anchors.right: prev.right
    margin-top: 11
    margin-bottom: 40
    margin-right: 14
    padding-top: 4
    padding-bottom: 4
    background-color: #3e3a35
    border: 1 #5d564d
    vertical-scrollbar: battlepassQuestsScrollBar
    layout:
      type: verticalBox

  VerticalScrollBar
    id: battlepassQuestsScrollBar
    anchors.bottom: prev.bottom
    anchors.top: prev.top
    anchors.left: prev.right
    step: 44
    pixels-scroll: true

  BattlePassActionButton
    text: Close
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 10
    margin-right: 14
    size: 160 26
    @onClick: modules.game_battlepass.m_BattlepassFunctions.destroy()

  BattlePassActionButton
    text: Premium Battlepass
    tooltip: If you already completed levels and you bought premium you cannot receive the rewards of completed levels.
    anchors.bottom: prev.bottom
    anchors.right: prev.left
    margin-right: 6
    size: 160 26
    @onClick: modules.game_battlepass.m_BattlepassFunctions.buyPremium()
  
  Label
    id: battlepassStatus
    anchors.verticalcenter: prev.verticalcenter
    anchors.left: questsPanel.left
    margin-left: 4
    color: #FFFFFF
    $on:
      color: #FC4B00
