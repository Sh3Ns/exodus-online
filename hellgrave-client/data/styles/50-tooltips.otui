ExtendedTooltipLabel < Label
  anchors.top: prev.bottom
  anchors.left: parent.left
  anchors.right: parent.right
  font: verdana-11px-rounded
  text-align: left

ExtendedTooltip < Panel
  background-color: #000000cc

  Panel
    id: header
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 34

    Panel
      id: header-left
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      width: 32
      image-source: /images/ui/item_tooltip_header

    Panel
      id: header-middle
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: prev.right
      anchors.right: next.left
      image-source: /images/ui/item_tooltip_header
      image-repeated: true

    Panel
      id: header-right
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      width: 30
      image-source: /images/ui/item_tooltip_header

  Label
    id: title
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 11
    text-align: center
    color: #C8C8C8
    font: verdana-11px-rounded

  Panel
    id: texts
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 34
    margin-bottom: 5
    margin-left: 5
    margin-right: 5