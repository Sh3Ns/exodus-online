GemSocketRow < Panel
  width: 588
  height: 58

  Label
    id: socketLabel
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 60
    text-auto-resize: false
    color: #e0e0e0

  UIWidget
    id: socketIcon
    anchors.left: socketLabel.right
    anchors.verticalCenter: parent.verticalCenter
    size: 43 43
    image-source: /images/sockets/empty_socket
    image-size: 45 45

    Item
      id: gemItem
      virtual: true
      phantom: true
      anchors.centerIn: parent
      size: 28 28
      padding: 0
      margin: 0
      background-color: alpha
      border-width: 0

  Panel
    id: gemTextPanel
    anchors.left: socketIcon.right
    anchors.right: removeButton.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    margin-right: 6
    height: 42
    layout:
      type: verticalBox
      spacing: 4

    Label
      id: gemText
      width: 340
      height: 16
      color: #cfcfcf
      text-wrap: false

    Panel
      id: gemMetaRow
      width: 340
      height: 20

      Panel
        id: gemStars
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 90
        height: 20
        layout:
          type: horizontalBox
          spacing: 2

  GemSocketMiniButton
    id: removeButton
    anchors.right: extractButton.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4
    width: 64
    text: Remove

  GemSocketMiniButton
    id: extractButton
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    width: 64
    text: Extract

