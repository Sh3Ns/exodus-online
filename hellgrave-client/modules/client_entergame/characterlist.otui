CharacterWidget < FlatPanel
  height: 112
  margin-bottom: 10
  padding: 10
  image-source: panel_map
  image-border: 10
  focusable: true

  &updateOnStates: |
    function(self)
      local focused = self:isFocused()
      self:setBorderWidth(focused and 2 or 1)
      self:setBorderColor(focused and '#D59A33' or '#313640')
      self:setBackgroundColor(focused and '#3F454CEE' or '#24272DDD')
      local children = self:getChildren()
      for i = 1, #children do
        if children[i].updateOnParentFocus then
          children[i]:updateOnParentFocus(focused)
        end
      end
    end
  @onFocusChange: self:updateOnStates()
  @onSetup: self:updateOnStates()

  UICreature
    id: creature
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10
    size: 64 64

  Label
    id: name
    anchors.top: parent.top
    anchors.left: creature.right
    width: 180
    margin-left: 16
    margin-right: 8
    margin-top: 18
    color: #F4D37A
    font: verdana-11px-rounded
    &updateOnParentFocus: |
      function(self, focused)
        self:setColor(focused and '#FFD671' or '#F4D37A')
      end

  Label
    id: level
    anchors.top: name.bottom
    anchors.left: name.left
    anchors.right: name.right
    margin-top: 3
    &baseText: 'Level %s'
    color: #D7DEE8
    font: verdana-11px-rounded

  Label
    id: vocation
    anchors.top: level.bottom
    anchors.left: name.left
    anchors.right: name.right
    margin-top: 2
    color: #92A8C7
    font: verdana-11px-rounded

  Label
    id: world
    anchors.top: parent.top
    anchors.right: parent.right
    width: 110
    margin-top: 20
    margin-right: 12
    text-align: right
    color: #E5A84B
    font: verdana-11px-rounded

  Label
    id: worldType
    anchors.top: world.bottom
    anchors.right: world.right
    width: 90
    margin-top: 3
    text-align: right
    color: #9AB2D0
    font: verdana-11px-rounded

CharacterActionButton < UIButton
  font: verdana-11px-rounded
  image-source: /images/ui/button_white
  image-color: #817d77
  image-border: 6
  height: 30
  padding: 6 14
  text-offset: 0 0
  text-align: center
  color: white
  change-cursor-image: true
  cursor: pointer

  $hover:
    image-color: #D59A33
    color: #FFF4CF

  $focus:
    image-color: #dfdfdf
    color: white

  $disabled:
    color: #9a9a9a

CharacterCancelButton < CharacterActionButton
  image-color: #6f3d3d

  $hover:
    image-color: #B64A4A
    color: #FFE4E4

  $focus:
    image-color: #D05A5A
    color: #FFE4E4

UIWidget
  id: charactersWindow
  visible: false
  anchors.top: parent.top
  anchors.bottom: parent.bottom
  anchors.left: parent.left
  anchors.right: parent.right
  margin-top: 36
  focusable: true
  @onEnter: CharacterList.doLogin()
  @onEscape: CharacterList.hide(true)
  @onKeyPress: |
    if keyCode == KeyEnter then
      CharacterList.doLogin()
      return true
    elseif keyCode == KeyEscape then
      CharacterList.hide(true)
      return true
    end
    return false
  @onSetup: |
    g_keyboard.bindKeyPress('Enter', function()
      CharacterList.doLogin()
    end, self)
    g_keyboard.bindKeyPress('Escape', function()
      CharacterList.hide(true)
    end, self)
    g_keyboard.bindKeyPress('Up', function()
      local characters = self and self:getChildById('characters')
      if characters then
        characters:focusPreviousChild(KeyboardFocusReason)
      end
    end, self)
    g_keyboard.bindKeyPress('Down', function()
      local characters = self and self:getChildById('characters')
      if characters then
        characters:focusNextChild(KeyboardFocusReason)
      end
    end, self)
  Panel
    id: leftColumn
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    width: 550
    margin: 0
    margin-top: 0
    border-width: 0
    background-color: #080B1233

    $mobile:
      width: 330

    Label
      id: listTitle
      !text: tr('SELECT CHARACTER')
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 54
      margin-left: 32
      color: #F1E8D3
      font: verdana-11px-rounded

    Label
      id: listSubtitle
      !text: tr('Descending by level')
      anchors.top: listTitle.bottom
      anchors.left: listTitle.left
      margin-top: 8
      color: #D3D3D3
      font: verdana-11px-rounded

    Label
      id: accountStatusCaption
      !text: tr('Account Status') .. ':'
      anchors.left: listTitle.left
      anchors.bottom: accountStatusLabel.top
      margin-bottom: 4
      color: #E2BD00
      font: verdana-11px-rounded

    Label
      id: accountStatusLabel
      !text: tr('Free Account')
      anchors.left: listTitle.left
      anchors.bottom: parent.bottom
      width: 260
      margin-bottom: 36
      text-auto-resize: true
      color: #F0A24C
      font: verdana-11px-rounded

      $on:
        color: #FF5E5E

    ScrollablePanel
      id: characters
      anchors.top: listSubtitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: accountStatusCaption.top
      margin-top: 30
      margin-left: 28
      margin-right: 30
      margin-bottom: 28
      padding-right: 4
      focusable: false
      auto-focus: first
      layout:
        type: verticalBox
      vertical-scrollbar: scrollBar

    VerticalScrollBar
      id: scrollBar
      anchors.top: characters.top
      anchors.bottom: characters.bottom
      anchors.right: parent.right
      margin-right: 12
      step: 44
      pixels-scroll: true

  Panel
    id: centerColumn
    anchors.top: parent.top
    anchors.bottom: footer.top
    anchors.left: leftColumn.right
    anchors.right: parent.right
    margin-top: 0
    margin-left: 0
    margin-right: 0
    margin-bottom: 0

    Panel
      id: sceneFrame
      anchors.fill: parent
      margin: 0

      Panel
        id: sceneBackground
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 0
        margin-top: 12
        size: 626 612
        image-source: /images/ui/scene
        image-border: 0

      Panel
        id: stageGlow
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.verticalCenter: parent.verticalCenter
        margin-top: 60
        margin-left: 0
        size: 260 260

      UICreature
        id: selectedCreature
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.verticalCenter: parent.verticalCenter
        margin-left: -65
        margin-top: -49
        size: 86 86

  Panel
    id: footer
    anchors.left: leftColumn.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 74
    margin-left: 0
    margin-right: 0
    margin-bottom: 38

    CharacterActionButton
      id: autoReconnect
      width: 160
      anchors.right: buttonOk.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 12

      $!on:
        image-color: #7f3e3e
        !text: tr('Auto reconnect: Off')

      $on:
        !text: tr('Auto reconnect: On')
        image-color: #2f7b36

    CharacterActionButton
      id: buttonOk
      !text: tr('Enter Game')
      width: 150
      image-color: #f0c74c
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      @onClick: CharacterList.doLogin()

    CharacterCancelButton
      id: buttonCancel
      !text: tr('Cancel')
      width: 100
      anchors.left: buttonOk.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 12
      @onClick: CharacterList.hide(true)
