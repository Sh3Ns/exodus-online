InboxDate < Label
  id: date
  anchors.top: parent.top
  anchors.left: parent.left
  text-auto-resize: true
  margin-top: 2
  margin-left: 2

InboxAcceptButton < GuildActionButton
  width: 104
  height: 24
  image-color: #3e7d32

  $hover:
    image-color: #4c9840
    color: white

  $focus:
    image-color: #57aa49
    color: white

InboxRejectButton < GuildActionButton
  width: 104
  height: 24
  image-color: #8b2e24

  $hover:
    image-color: #a83b2f
    color: white

  $focus:
    image-color: #b84a3d
    color: white

DepositInbox < Panel
  height: 89
  background-color: #4a443d
  border: 1 #5a5248

  Label
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2
    !text: tr("Gold Deposit")
    text-auto-resize: true

  InboxDate
  
  Panel
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 18
    image-source: /images/guild_hall/deposit
  
  Panel
    id: panel
    anchors.top: parent.top
    anchors.left: prev.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 18
    margin-left: 2
    padding: 2
    phantom: false
    background-color: #4a443d

    Label
      id: text
      anchors.fill: parent
      text-wrap: true

