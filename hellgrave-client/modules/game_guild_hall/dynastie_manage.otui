GuildDynastieManageWindow < MainWindow
  size: 1120 760
  !text: tr("Dynasty Panel")
  font: sans-bold-16px
  text-offset: 0 4
  padding-bottom: 6
  @onEscape: modules.game_guild_hall.closeDynastieManageWindow()

  Panel
    id: dynastieTabBackground
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    width: 1060
    height: 110
    margin-top: 14
    background-color: #39342f
    border: 1 #534b43

  Panel
    id: manageTabs
    anchors.top: parent.top
    anchors.left: parent.left
    height: 86
    margin-left: 28
    width: 1040
    margin-top: 21

    DynastieManageTabButton
      id: generalTabBtn
      anchors.left: parent.left
      anchors.top: parent.top
      size: 180 34
      !text: tr("General")

    DynastieManageTabButton
      id: questsTabBtn
      anchors.left: generalTabBtn.right
      anchors.top: parent.top
      margin-left: 6
      size: 180 34
      !text: tr("Dynasty Quests")

    DynastieManageTabButton
      id: perksTabBtn
      anchors.left: questsTabBtn.right
      anchors.top: parent.top
      margin-left: 6
      size: 180 34
      !text: tr("Dynasty Perks")

    DynastieManageTabButton
      id: defendersTabBtn
      anchors.left: perksTabBtn.right
      anchors.top: parent.top
      margin-left: 6
      size: 180 34
      !text: tr("Defenders")

    DynastieManageTabButton
      id: passiveTreeTabBtn
      anchors.left: defendersTabBtn.right
      anchors.top: parent.top
      margin-left: 6
      size: 180 34
      !text: tr("Passive Tree")

    DynastieManageTabButton
      id: achievementsTabBtn
      anchors.left: parent.left
      anchors.top: generalTabBtn.bottom
      margin-top: 8
      size: 180 34
      !text: tr("Achievements")

    DynastieManageTabButton
      id: eventCalendarTabBtn
      anchors.left: achievementsTabBtn.right
      anchors.top: achievementsTabBtn.top
      margin-left: 6
      size: 180 34
      !text: tr("Event Calendar")

    DynastieManageTabButton
      id: boardQuestsTabBtn
      anchors.left: eventCalendarTabBtn.right
      anchors.top: eventCalendarTabBtn.top
      margin-left: 6
      size: 180 34
      !text: tr("Board Quests")

  Panel
    id: bodyPanel
    anchors.top: dynastieTabBackground.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-top: 10
    margin-left: 10
    margin-right: 10
    margin-bottom: 10
    background-color: #3e3a35
    border: 1 #59524a
    padding: 14

    Panel
      id: generalView
      anchors.fill: parent

      Panel
        id: mainCard
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.bottom: parent.bottom
        width: 300
        image-source: /images/ui/prism_panel
        image-border: 8
        background-color: #4a443d
        border: 1 #5a5248
        padding: 14

        Label
          id: title
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          text-auto-resize: true
          font: verdana-11px-rounded

        UIItem
          id: dynastieItem
          anchors.top: title.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 16
          size: 64 64
          virtual: true

        Label
          id: owner
          anchors.top: dynastieItem.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 18
          text-wrap: true
          text-align: center
          color: #dfdfdf

        Label
          id: placer
          anchors.top: owner.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 4
          text-wrap: true
          text-align: center
          color: #b9b2a8

        Label
          id: emptyState
          anchors.top: placer.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 14
          height: 36
          visible: false
          text-wrap: true
          text-align: center
          color: #c7c1b6
          !text: tr("You do not own a Dynastie Core yet.")

        Label
          id: timer
          anchors.top: emptyState.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 14
          height: 30
          text-wrap: true
          text-align: center
          color: #FFDC96

        Label
          id: tax
          anchors.top: timer.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 8
          text-wrap: true
          text-align: center
          color: #c7c1b6

