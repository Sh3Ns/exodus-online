  Label
    id: objective
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: icon.bottom
    margin-top: 10
    height: 34
    text-wrap: true
    text-align: center
    color: #dfdfdf

  Panel
    id: rewardsContainer
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: objective.bottom
    margin-top: 8
    height: 90

    Panel
      id: rewardsItems
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      height: 66

    Label
      id: rewardsText
      anchors.top: rewardsItems.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 18
      text-wrap: false
      text-align: center
      color: #c7c1b6

    Label
      id: rewardsFallback
      anchors.top: rewardsItems.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 18
      text-wrap: true
      text-align: center
      color: #c7c1b6
      visible: false

  Label
    id: repeatInfo
    anchors.top: rewardsContainer.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 18
    text-wrap: true
    text-align: center
    color: #b9b2a8

  Label
    id: ownerRewardsLabel
    anchors.top: repeatInfo.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 18
    text-wrap: false
    text-align: center
    color: #b9b2a8
    !text: tr("Reward for the Dynastie Core of that city:")

  Label
    id: ownerRewardsDivider
    anchors.top: ownerRewardsLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    height: 14
    text-align: center
    color: #8d867d
    !text: tr("-------------------")

  Panel
    id: ownerRewardsContainer
    anchors.top: ownerRewardsDivider.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    height: 90

    Panel
      id: rewardsItems
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      height: 66

    Label
      id: rewardsText
      anchors.top: rewardsItems.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 18
      text-wrap: false
      text-align: center
      color: #c7c1b6

    Label
      id: rewardsFallback
      anchors.top: rewardsItems.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 18
      text-wrap: true
      text-align: center
      color: #c7c1b6
      visible: false

  GuildActionButton
    id: acceptButton
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 6
    width: 96
    !text: tr("Accept")

DynastieGuildPerkItem < UIWidget
  image-source: /images/ui/inner_content_panel
  image-border: 10
  padding: 5
  border: 0 white
  size: 322 156

  $focus:
    border: 1 white

  UIWidget
    id: icon
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 58 58
    phantom: true

  Label
    id: name
    anchors.left: parent.left
    anchors.top: parent.top
    text-wrap: true
    text-auto-resize: true
    width: 228
    font: verdana-11px-rounded

  Label
    id: level
    anchors.left: parent.left
    anchors.top: name.bottom
    text-auto-resize: true
    font: verdana-11px-rounded

  Label
    id: requiredLevel
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    color: #8A8B7F
    text-auto-resize: true
    font: verdana-11px-rounded

  Label
    id: costLabel
    anchors.left: parent.left
    anchors.bottom: requiredLevel.top
    text-auto-resize: true
    color: #FFF600
    font: verdana-11px-rounded

  Label
    id: costValue
    anchors.left: costLabel.right
    anchors.bottom: costLabel.bottom
    text-auto-resize: true
    color: #FFF600
    font: verdana-11px-rounded

  Label
    id: premiumCostLabel
    anchors.left: parent.left
    anchors.bottom: costLabel.top
    margin-bottom: 2
    text-auto-resize: true
    color: #7AD7FF
    font: verdana-11px-rounded
    visible: false

  Label
    id: premiumCostValue
    anchors.left: premiumCostLabel.right
    anchors.bottom: premiumCostLabel.bottom
    text-auto-resize: true
    color: #7AD7FF
    font: verdana-11px-rounded
    visible: false

  UIWidget
    id: costLayer
    anchors.left: costLabel.left
    anchors.right: costValue.right
    height: 20
    anchors.top: costLabel.top
    font: verdana-11px-rounded

  UIWidget
    id: bonus
    anchors.left: parent.left
    anchors.top: level.bottom
    anchors.right: icon.right
    anchors.bottom: premiumCostLabel.top
    margin-top: 5
    text-wrap: true
    text-align: topleft
    color: #FF9D00
    phantom: true
    font: verdana-11px-rounded

DynastieDefenderCard < Panel
  size: 272 380
  image-source: /images/ui/prism_panel
  image-border: 8
  background-color: #433d37
  border: 1 #59524a
  padding: 3

  Label
    id: name
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    font: verdana-11px-rounded
    text-auto-resize: true
    color: #FFDC96

  Label
    id: role
    anchors.top: name.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4
    text-auto-resize: true
    color: #c7c1b6

  Label
    id: quantity
    anchors.top: role.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 6
    text-auto-resize: true
    color: #FFDC96

  Panel
    id: outfitPanel
    anchors.top: quantity.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 110
    margin-top: 10
    background-color: #3b3732
    border: 1 #59524a

    UICreature
      id: creature
      anchors.centerIn: parent
      size: 84 84
      outfit-center: true
      animate: true
      phantom: true

  Label
    id: level
    anchors.top: outfitPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 12
    text-align: center
    color: #dfdfdf

  Label
    id: health
    anchors.top: level.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    text-align: center
    color: #dfdfdf

  Label
    id: distance
    anchors.top: health.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    text-align: center
    color: #dfdfdf

  Label
    id: speed
    anchors.top: distance.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    text-align: center
    color: #dfdfdf

  Label
    id: mitigation
    anchors.top: speed.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    text-align: center
    color: #dfdfdf

  Label
    id: damage
    anchors.top: mitigation.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    text-align: center
    color: #dfdfdf

  Label
    id: attacks
    anchors.top: damage.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: -10
    height: 68
    text-wrap: true
    text-align: center
    color: #c7c1b6

  Label
    id: costs
    anchors.bottom: upgradeButton.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 27
    height: 44
    text-wrap: true
    text-align: center
    color: #b9b2a8

  GuildActionButton
    id: upgradeButton
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 5
    width: 136
    !text: tr("Upgrade")

DynastieAchievementCard < UIWidget
  image-source: /images/ui/prism_panel
  image-border: 8
  padding: 8
