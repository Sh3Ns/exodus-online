DynastieManageTabButton < UIButton
  size: 160 34
  font: verdana-11px-rounded
  image-source: /images/ui/button_white
  image-color: #817d77
  image-border: 6
  anchors.top: parent.top
  padding: 6 10
  text-offset: 26 0
  text-align: center

  $hover !checked:
    image-color: #bfbfbf

  $checked:
    image-color: #dfdfdf

  $focus:
    image-color: #dfdfdf

GuildRewardSlot < UIWidget
  size: 48 48
  background-color: #2f2c28
  border: 1 #5a534b

  UIItem
    id: item
    anchors.centerIn: parent
    size: 32 32
    virtual: true
    phantom: true

  UIWidget
    id: icon
    anchors.centerIn: parent
    size: 32 32
    visible: false

  Label
    id: count
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 3
    margin-bottom: 1
    text-align: right
    color: #dfdfdf
    font: verdana-11px-rounded
    text-auto-resize: true

DynastieBoardQuestCard < UIWidget
  image-source: /images/ui/prism_panel
  image-border: 8
  background-color: #433d37
  border: 1 #59524a
  padding: 8
  size: 312 334

  UIWidget
    id: icon
    anchors.left: parent.left
    anchors.top: parent.top
    size: 64 64
    image-source: /images/guild_hall/dynasty_achievement

  Label
    id: title
    anchors.left: icon.right
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 10
    text-auto-resize: true
    font: verdana-11px-rounded

  Label
    id: progress
    anchors.left: icon.right
    anchors.right: parent.right
    anchors.top: title.bottom
    margin-left: 10
    margin-top: 6
    color: #FFDC96
    text-wrap: true

  Panel
    id: rewardsContainer
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: icon.bottom
    margin-top: 10
    height: 90

    Panel
      id: rewardsItems
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      height: 66

    Label
      id: rewardsText
      anchors.top: rewardsItems.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 18
      text-wrap: false
      text-align: center
      color: #c7c1b6

    Label
      id: rewardsFallback
      anchors.top: rewardsItems.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 18
      text-wrap: true
      text-align: center
      color: #c7c1b6
      visible: false

  Label
    id: ownerRewardsLabel
    anchors.top: rewardsContainer.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 18
    text-wrap: false
    text-align: center
    color: #b9b2a8
    !text: tr("Reward for the Dynastie Core of that city:")

  Label
    id: ownerRewardsDivider
    anchors.top: ownerRewardsLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    height: 14
    text-align: center
    color: #8d867d
    !text: tr("-------------------")

  Panel
    id: ownerRewardsContainer
    anchors.top: ownerRewardsDivider.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    height: 90

    Panel
      id: rewardsItems
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      height: 66

    Label
      id: rewardsText
      anchors.top: rewardsItems.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 18
      text-wrap: false
      text-align: center
      color: #c7c1b6

    Label
      id: rewardsFallback
      anchors.top: rewardsItems.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 18
      text-wrap: true
      text-align: center
      color: #c7c1b6
      visible: false

  Label
    id: timer
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 6
    color: #b9b2a8
    text-align: center

DynastieBoardOfferCard < UIWidget
  image-source: /images/ui/prism_panel
  image-border: 8
  background-color: #433d37
  border: 1 #59524a
  padding: 8
  size: 300 404

  UIWidget
    id: icon
    anchors.left: parent.left
    anchors.top: parent.top
