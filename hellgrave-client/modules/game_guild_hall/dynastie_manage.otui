    image-size: 104 104

  Label
    id: objective
    anchors.top: icon.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    height: 40
    text-wrap: true
    text-align: center
    color: #dfdfdf

  Label
    id: progress
    anchors.top: objective.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    height: 18
    text-wrap: true
    text-align: center
    color: #FFDC96

  Panel
    id: rewardsContainer
    anchors.top: progress.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    height: 130

    Panel
      id: rewardsItems
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 100

    Label
      id: rewardsText
      anchors.top: rewardsItems.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 18
      text-wrap: false
      text-align: center
      color: #c7c1b6

    Label
      id: rewardsFallback
      anchors.top: rewardsItems.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 18
      text-wrap: true
      text-align: center
      color: #c7c1b6
      visible: false

  Label
    id: state
    anchors.bottom: claimButton.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 10
    height: 23
    text-wrap: true
    text-align: center
    color: #b9b2a8

  GuildActionButton
    id: claimButton
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 5
    width: 96
    !text: tr("Claim")

DynastieCalendarDayCard < UIWidget
  image-source: /images/ui/prism_panel
  image-border: 8
  padding: 6
  size: 134 128
  background-color: #4a443d
  border: 1 #5a5248

  Label
    id: weekday
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 16
    text-align: center
    font: verdana-11px-rounded
    color: #dfdfdf

  Label
    id: dayNumber
    anchors.top: weekday.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 16
    text-align: center
    color: #dfdfdf

  Label
    id: city
    anchors.top: dayNumber.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 16
    text-align: center
    color: #FFDC96

  Label
    id: eventName
    anchors.top: city.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 26
    text-wrap: true
    text-align: center
    color: #dfdfdf

  Label
    id: time
    anchors.top: eventName.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 14
    text-align: center
    color: #b9b2a8

  Label
    id: description
    anchors.top: time.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 4
    margin-bottom: 4
    text-wrap: true
    text-align: center
    color: #c7c1b6
    visible: false

DynastiePerkCard < Panel
  size: 262 330
  image-source: /images/ui/prism_panel
  image-border: 8
