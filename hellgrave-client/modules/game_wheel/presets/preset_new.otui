MainWindow
  id: newPreset
  !text: tr('New Preset')
  anchors.horizontalCenter: parent.horizontalCenter
  size: 625 201
  padding-top: 17
  padding-left: 4
  padding-right: 4
  padding-bottom: 4
  @onEscape: modules.game_wheel.WheelDestiny.HideNewPreset()

  Panel
    id: contentPanel
    anchors.fill: parent
    margin: 12 12 12 12

    Label
      id: presetNameLabel
      !text: tr('Preset name:')
      anchors.top: parent.top
      anchors.left: parent.left
      text-auto-resize: true
      color: #C0C0C0
      font: Verdana Bold-11px
      margin-top: -1
      margin-left: -1

    UIWidget
      id: presetNameTooltip
      size: 12 12
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 6
      margin-top: 2
      image-source: /modules/game_wheel/images/icon_info
      phantom: false
      !tooltip: tr('Presets names need to be unique. Also, this field must not be empty.')

    TextEdit
      id: presetName
      size: 164 24
      focusable: true
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      color: #C0C0C0
      !placeholder: tr('Enter a unique name')
      font: Verdana Bold-11px

    CheckBox
      id: useEmpty
      size: 12 12
      !text: tr('Use empty Wheel of Destiny')
      font: Verdana Bold-11px
      text-auto-resize: true
      color: #C0C0C0
      text-offset: 20 0
      anchors.top: prev.bottom
      anchors.left: parent.left
      change-cursor-image: false
      margin-top: 11

    CheckBox
      id: copyPreset
      size: 12 12
      !text: tr("Copy preset 'Default-Preset'")
      font: Verdana Bold-11px
      text-auto-resize: true
      color: #C0C0C0
      text-offset: 20 0
      anchors.top: prev.bottom
      anchors.left: parent.left
      change-cursor-image: false
      margin-top: 5

    CheckBox
      id: import
      size: 12 12
      !text: tr('Import')
      font: Verdana Bold-11px
      text-auto-resize: true
      color: #C0C0C0
      anchors.top: prev.bottom
      anchors.left: parent.left
      change-cursor-image: false
      margin-top: 5

    UIWidget
      id: importTooltip
      size: 12 12
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 6
      margin-top: 2
      image-source: /modules/game_wheel/images/icon_info
      phantom: false
      !tooltip: tr('Paste a Wheel of Destiny export code here to create a preset from it.')
      visible: false

    TextEdit
      id: presetCode
      size: 164 24
      focusable: true
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      color: #C0C0C0
      font: Verdana Bold-11px
      !placeholder: tr('Enter copied export code or URL of the planner, e.g. EKAABkZJbI...')

    HorizontalSeparator
      id: separator
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5

    WheelMiniButton
      id: cancel
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      !text: tr('Cancel')
      size: 60 25
      margin-bottom: -10
      font: verdana-bold-8px-antialiased
      @onClick: modules.game_wheel.WheelDestiny.HideNewPreset()

    WheelMiniButton
      id: ok
      anchors.bottom: parent.bottom
      anchors.right: prev.left
      !text: tr('Ok')
      size: 60 25
      margin-right: 5
      margin-bottom: -10
      enabled: false
      font: verdana-bold-8px-antialiased
      @onClick: modules.game_wheel.WheelDestiny.CreatePreset()
