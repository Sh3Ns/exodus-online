WheelGemDescription < Label
  text-align: left
  color: #C0C0C0

  $disabled:
    color: #707070

WheelActionButton < UIButton
  font: verdana-11px-rounded
  image-source: /images/ui/button_white
  image-color: #817d77
  image-border: 10
  height: 24
  padding: 4 12
  text-offset: 0 0
  text-align: center
  color: white

  $hover !disabled:
    image-color: #9a958e

  $checked:
    image-color: #dfdfdf

  $focus:
    image-color: #dfdfdf

  $disabled:
    image-color: #625f5b
    color: #9a9a9a

WheelMiniButton < WheelActionButton
  height: 20
  padding: 2 8
  font: verdana-bold-8px-antialiased
  text-offset: 0 -1

WheelButton < WheelMiniButton
  change-cursor-image: false

WheelTabButton < WheelActionButton
  height: 34
  font: verdana-11px-rounded
  text-offset: 25 0

WheelCard < Panel
  background-color: #3e3a35
  border: 1 #5d564d
  padding: 6

WheelSlot < UIWidget

WheelSlotFull < UIWidget
  id: full
  anchors.centerIn: parent
  visible: true
  phantom: true

WheelSlotUnlocked < UIWidget
  id: unlocked
  anchors.centerIn: parent
  visible: false
  phantom: true

WheelSlotHover < UIWidget
  id: hover
  anchors.centerIn: parent
  visible: false
  phantom: true

WheelSlotSelected < UIWidget
  id: selected
  anchors.centerIn: parent
  visible: false
  phantom: true

WheelSlotMediumPerk < UIWidget
  id: mediumPerk
  size: 30 30
  anchors.centerIn: parent
  image-source: images/icons-skillwheel-mediumperks
  phantom: true

WheelSlotSmallPerk < UIWidget
  id: smallPerk
  size: 16 16
  anchors.bottom: parent.bottom
  anchors.left: parent.left
  margin-bottom: -2
  margin-left: -2
  image-source: images/icons-skillwheel-smallperks
  phantom: true

Window
  id: wheelUI
  size: 1000 760
  !text: ('Wheel of Destiny')
  anchors.centerIn: parent
  change-cursor-image: true
  cursor: pointer

  UIWidget
    id: dragHandle
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: -36
    margin-left: -16
    margin-right: -16
    height: 27
    phantom: false
    change-cursor-image: true
    cursor: pointer

  Panel
    size: 968 36
    id: buttons
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    image-source: /images/ui/panel_flat
    image-border: 10

    WheelTabButton
      id: wheelButton
      size: 322 34
      text-offset: 25 0
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 1
      margin-left: 1
      text: Wheel of Destiny
      @onClick: modules.game_wheel.WheelDestiny.changeHome(self)

      UIWidget
        id: icon
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: parent.left
        size: 30 30
        margin-left: 10
        image-source: images/icon-skillwheel-large
        phantom: true
        
      UIWidget
        id: layer
        anchors.fill: parent
        visible: false
        phantom: true
        focusable: false

    WheelTabButton
      id: gemButton
      size: 322 34
      text-offset: 25 0
      anchors.top: parent.top
      anchors.left: wheelButton.right
      margin-top: 1
      margin-left: 1
      text: Gem Atelier
      @onClick: modules.game_wheel.WheelDestiny.changeHome(self)

      UIWidget
        id: icon
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: parent.left
        margin-left: 10
        size: 30 30
        image-source: images/icon-gematelier
        phantom: true
        
      UIWidget
        id: layer
        anchors.fill: parent
        visible: false
        phantom: true
        focusable: false

    WheelTabButton
      id: fragmentButton
      size: 322 34
      text-offset: 25 0
      anchors.top: parent.top
      anchors.left: gemButton.right
      margin-top: 1
      margin-left: 1
      text: Fragment Workshop
      @onClick: modules.game_wheel.WheelDestiny.changeHome(self)

      UIWidget
        id: icon
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: parent.left
        margin-left: 10
        image-source: images/icon-fragmentworkshop
        size: 30 30
        phantom: true
        
      UIWidget
        id: layer
        anchors.fill: parent
        visible: false
        phantom: true
        focusable: false

  Panel
    id: main
    anchors.fill: parent
    anchors.centerIn: parent
    margin-top: 52

    HorizontalSeparator
      id: separator
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-bottom: 65

    WheelMiniButton
      id: closeButton
      size: 55 26
      anchors.top: separator.top
      anchors.right: parent.right
      !text: tr('Close')
      font: verdana-bold-8px-antialiased
      text-offset: 0 -1
      color: #C0C0C0
      margin-top: 12
      @onClick: modules.game_wheel.WheelDestiny.Toggle()

    WheelMiniButton
      id: resetButton
      size: 55 26
      anchors.top: closeButton.top
      anchors.right: closeButton.left
      !text: tr('Reset')
      font: verdana-bold-8px-antialiased
      text-offset: 0 -1
      color: #C0C0C0
      margin-right: 6
      @onClick: modules.game_wheel.WheelDestiny.reset()

    WheelMiniButton
      id: applyButton
      size: 55 26
      anchors.top: resetButton.top
      anchors.right: resetButton.left
      !text: tr('Apply')
      font: verdana-bold-8px-antialiased
      text-offset: 0 -1
      color: #C0C0C0
      margin-right: 6
      enabled: false
      @onClick: modules.game_wheel.WheelDestiny.send()

    WheelMiniButton
      id: okButton
      size: 55 26
      anchors.top: applyButton.top
      anchors.right: applyButton.left
      !text: tr('Ok')
      font: verdana-bold-8px-antialiased
      text-offset: 0 -1
      color: #C0C0C0
      margin-right: 6
      enabled: false
      @onClick: modules.game_wheel.WheelDestiny.send(true)

    UIWidget
      id: goldBalance
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      size: 130 20
      image-source: /images/ui/item
      image-border: 10
      margin-bottom: 22
      
      UIWidget
        id: icon
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        image-source: /modules/game_wheel/images/icon_gold
        margin-right: 5
            
      Label
        id: value
        color: #C0C0C0
        anchors.right: icon.left
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 5
        text-auto-resize: true
        text-align: right
        text: 0

    UIWidget
      id: lesserFragmentsBalance
      anchors.top: goldBalance.top
      anchors.left: goldBalance.right
      size: 130 20
      image-source: /images/ui/item
      image-border: 10
      margin-left: 6
      
      UIWidget
        id: icon
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        image-source: /modules/game_wheel/images/icon-fragments-lesser
        margin-right: 5
            
      Label
        id: value
        color: #C0C0C0
        anchors.right: icon.left
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 5
        text-auto-resize: true
        text-align: right
        text: 0

    UIWidget
      id: greaterFragmentsBalance
      anchors.top: lesserFragmentsBalance.top
      anchors.left: lesserFragmentsBalance.right
      size: 130 20
      image-source: /images/ui/item
      image-border: 10
      margin-left: 6
      
      UIWidget
        id: icon
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        image-source: /modules/game_wheel/images/icon-fragments-greater
        margin-right: 5
            
      Label
        id: value
        color: #C0C0C0
        anchors.right: icon.left
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 5
        text-auto-resize: true
        text-align: right
        text: 0

    WheelMiniButton
      id: presetButton
      size: 105 25
      anchors.top: greaterFragmentsBalance.top
      anchors.left: greaterFragmentsBalance.right
      margin-left: 6
      !text: tr('Presets')
      @onClick: modules.game_wheel.WheelDestiny.ShowPresets()

    Label
      id: presetLabel
      !text: tr('Current preset: Default-Preset')
      text-auto-resize: true
      anchors.verticalCenter: presetButton.verticalCenter
      anchors.left: presetButton.right
      margin-left: 6
      color: #C0C0C0
