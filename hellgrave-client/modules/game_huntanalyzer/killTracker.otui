InfoLabel < Label

Creature < UICreature
  size: 32 32
  padding: 1
  anchors.top: parent.top
  anchors.left:parent.left

MonsterNameLabel < Label

CreatureCountLabel < Label
  font: verdana-11px-antialised
  color: #afafaf
  text-auto-resize: true

AnalyzerActionButton < UIButton
  font: verdana-11px-rounded
  image-source: /images/ui/button_white
  image-color: #817d77
  image-border: 6
  height: 24
  padding: 4 12
  text-offset: 0 0
  text-align: center
  color: white

  $hover:
    image-color: #9a958e
    color: white

  $focus:
    image-color: #dfdfdf
    color: white

  $disabled:
    color: #9a9a9a

MiniWindow
  id: killWindow
  !text: tr('Kill Tracker')
  color: #8F8F8F
  height: 200
  &save: true

  MiniWindowContents
    padding-left: 5
    padding-right: 5
    margin-top: 18
    vertical-scrollbar: miniwindowScrollBar
    layout: verticalBox

    AnalyzerActionButton
      id: resetSession
      width: 64
      margin-top: 5
      !text: tr("Reset Kills")
      &onClick: resetKillTracker

    AnalyzerActionButton
      id: clipBoard
      width: 32
      !text: tr("Copy Kill Session")
      &onClick: copyKillToClipboard

    InfoLabel
      id: monsterLabel
      !text: tr('Monsters:')
      font: verdana-11px-antialised
      color: #afafaf
      width: 200
      margin-top: 10
