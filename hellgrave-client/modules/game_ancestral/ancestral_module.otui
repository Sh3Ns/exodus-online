AncestralActionButton < UIButton
  font: verdana-11px-rounded
  image-source: /images/ui/button_white
  image-color: #817d77
  image-border: 6
  height: 24
  padding: 4 12
  text-offset: 0 0
  text-align: center
  color: white

  $hover:
    image-color: #9a958e
    color: white

  $focus:
    image-color: #dfdfdf
    color: white

  $disabled:
    color: #9a9a9a

AncestralFlatPanel < Panel
  image-source: /images/ui/panel_content
  image-border: 10
  border: 0 white
  padding: 6

AncestralLightPanel < Panel
  image-source: /images/ui/panel_content
  image-border: 10
  border: 0 white
  padding: 6

StoreCategoryButton < UIButton
  font: verdana-11px-antialised
  color: #d8d8d8
  text-offset: 42 0
  text-align: left
  image-source: /images/ui/panel_content
  image-border: 10
  height: 42
  margin-bottom: 3
  padding: 4
  border: 0 white
  icon-rect: 6 5 32 32

  $hover:
    color: #ffffff

  $checked:
    color: #ffffff

ProductButton < UIButton
  font: verdana-11px-antialised
  color: #dfdfdf
  text-align: center
  image-source: /images/ui/panel_content
  image-border: 10
  size: 118 132
  margin-right: 5
  margin-bottom: 5
  border: 0 white

  $hover:
    color: #ffffff

  Label
    id: productLabelTitle
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 24
    margin: 4
    padding: 2
    text-align: center
    text-wrap: true
    font: verdana-11px-antialised
    color: #ffffff
    image-source: /images/ui/panel_content
    image-border: 10
    border: 0 white

  Label
    id: productLabelImage
    anchors.top: productLabelTitle.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 7
    size: 64 64
    image-size: 64 64
    image-fixed-ratio: true

  AncestralFlatPanel
    id: pricePanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 24
    margin: 4

    Label
      id: coinIcon
      image-source: /images/ancestral/ancestral_coin
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 19
      size: 12 12

    Label
      id: productLabelTokenPrice
      anchors.left: coinIcon.right
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      margin-right: 10
      height: 16
      text-align: left
      font: verdana-11px-antialised
      color: #dfdfdf

MainWindow
  id: storeWindow
  !text: tr('Ancestral Store')
  size: 720 500
  padding-top: 36
  padding-left: 16
  padding-right: 16
  padding-bottom: 16

  @onEnter: modules.ancestral_module.onCloseStore()
  @onEscape: modules.ancestral_module.onCloseStore()

  AncestralLightPanel
    id: balanceInfo
    anchors.top: parent.top
    anchors.left: parent.left
    size: 185 86

    Label
      !text: tr('Ancestral Points')
      font: verdana-11px-antialised
      color: #dfdfdf
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 0
      height: 16

    Label
      id: coinIcon
      image-source: /images/ancestral/ancestral_coin
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 20
      margin-left: 57
      size: 12 12

    Label
      id: coinBalance
      !text: tr('0')
      font: verdana-11px-antialised
      color: #e27a12
      anchors.left: coinIcon.right
      anchors.top: coinIcon.top
      margin-top: 0
      margin-left: 6
      height: 16
      width: 90

    Label
      !text: tr('Earn points by completing tasks for Armin.')
      font: verdana-11px-antialised
      color: #cfcfcf
      text-align: center
      text-wrap: true
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 10
      margin: 8
      height: 28

  AncestralLightPanel
    id: indexDescription
    anchors.top: balanceInfo.top
    anchors.left: balanceInfo.right
    anchors.right: parent.right
    margin-left: 8
    margin-right: 8
    height: 86

    Label
      id: imageDesc
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 14
      size: 48 48
      image-size: 48 48
      image-fixed-ratio: true

    Label
      id: titleDesc
      font: verdana-11px-antialised
      color: #dfdfdf
      anchors.top: imageDesc.top
      anchors.left: imageDesc.right
      anchors.right: parent.right
      margin-left: 14
      margin-right: 10
      height: 18

    Label
      id: description
      font: verdana-11px-antialised
      color: #dfdfdf
      text-wrap: true
      anchors.top: titleDesc.bottom
      anchors.left: titleDesc.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 6
      margin-right: 10

  Label
    !text: tr('Categories')
    anchors.top: balanceInfo.bottom
    anchors.left: balanceInfo.left
    margin-top: 8
    height: 16
    width: 185
    font: verdana-11px-antialised
    color: #dfdfdf

  TextList
    id: indexList
    anchors.top: prev.bottom
    anchors.left: balanceInfo.left
    size: 185 318
    margin-top: 4
    padding: 4
    image-source: /images/ui/panel_content
    image-border: 10
    border: 0 white

  Label
    id: productsTitle
    !text: tr('Offers')
    anchors.top: indexDescription.bottom
    anchors.left: indexDescription.left
    anchors.right: indexDescription.right
    margin-top: 8
    height: 16
    font: verdana-11px-antialised
    color: #dfdfdf

  ScrollablePanel
    id: productList
    anchors.top: productsTitle.bottom
    anchors.left: indexDescription.left
    anchors.right: indexDescription.right
    anchors.bottom: footer.top
    margin-top: 4
    margin-bottom: 8
    padding: 6
    padding-right: 14
    image-source: /images/ui/panel_content
    image-border: 10
    border: 0 white
    vertical-scrollbar: productListScrollbar
    layout:
      type: grid
      flow: true
      cell-size: 123 137

  VerticalScrollBar
    id: productListScrollbar
    anchors.top: productList.top
    anchors.bottom: productList.bottom
    anchors.right: productList.right
    margin-top: 1
    margin-right: 1
    margin-bottom: 1
    step: 14
    pixels-scroll: true

  AncestralLightPanel
    id: footer
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 38

    AncestralActionButton
      id: closeButton
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      !text: tr('Close')
      width: 110
      height: 24
      @onClick: modules.ancestral_module.onCloseStore()
