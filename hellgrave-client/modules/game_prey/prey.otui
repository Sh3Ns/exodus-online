Star < UIWidget
  size: 9 10
  image-source: /images/game/prey/prey_star

NoStar < UIWidget
  size: 9 10
  image-source: /images/game/prey/prey_nostar

PreyActionButton < UIButton
  font: verdana-11px-rounded
  image-source: /images/ui/button_white
  image-color: #817d77
  image-border: 6
  height: 24
  padding: 4 12
  text-offset: 0 0
  text-align: center
  color: white

  $hover:
    image-color: #9a958e
    color: white

  $focus:
    image-color: #dfdfdf
    color: white

  $disabled:
    color: #9a9a9a

PreyTabButton < UIButton
  height: 32
  image-source: /images/game/prey/panel_map
  image-border: 3
  font: Verdana Bold-11px
  color: #c0c0c0
  text-align: center

  $hover:
    color: white

  $checked:
    image-source: /images/game/prey/window
    image-border: 8
    color: white

WildcardLabel < UIWidget
  size: 191 16
  font: Verdana Bold-11px
  color: #c0c0c0
  text-auto-resize: true
  phantom: false
  text-offset: 0 0
  $focus:
    color: #f4f4f4

  UIWidget
    id: icon
    size: 17 16
    image-source: /images/game/prey/prey_inactive
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 2
    visible: false

WildcardPreyPanel < Panel
  size: 195 312
  TextList
    id: monsterList
    size: 204 178
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    vertical-scrollbar: monsterListScrollBar
    keep-scroll-range: true
    @onSetup: |
      g_keyboard.bindKeyPress('Up', function() focusPrevWildcardLabel(self) end, self)
      g_keyboard.bindKeyPress('Down', function() focusNextWildcardLabel(self) end, self)
    layout:
      type: grid
      num-columns: 1
      cell-size: 191 16

  VerticalScrollBar
    id: monsterListScrollBar
    anchors.top: prev.top
    anchors.right: prev.right
    anchors.bottom: prev.bottom
    height: 178
    margin-right: 1
    margin-bottom: 1
    margin-top: 1
    step: 1

  TextEdit
    id: searchText
    size: 205 21
    !placeholder: tr('Type to search')
    color: #c0c0c0
    text-offset: 1 1
    anchors.top: prev.bottom
    anchors.right: parent.right
    anchors.left: parent.left
    margin-top: 6
    @onTextChange: onTextEdit(self)

  FlatPanel
    id: panel
    size: 134 92
    margin-top: 6
    anchors.top: prev.bottom
    anchors.left: parent.left
    phantom: false
    UICreature
      id: creature
      idle-animate: true
      anchors.verticalCenter: parent.verticalCenter
      anchors.horizontalCenter: parent.horizontalCenter
      idle-animate: true
      size: 64 64
      phantom: true
      force-center: true
      outfit-center: true
      old-scaling: true
  ChoosePrey
    id: choose
    size: 66 92
    anchors.right: parent.right
    anchors.top: prev.top

LockedPreyPanel < Panel
  size: 223 340
  NoCreaturePanel
    id: noCreature
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right

  UIButton
    id: perm
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 64
    margin-top: 7
    @onClick: modules.game_shop.show()

    UIWidget
      id: shopPermButton
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      image-source: /images/game/prey/prey_perm_test
      size: 207 67
      image-clip: 0 0 207 67
      @onClick: modules.game_prey.storeRedirect(0)
      @onHoverChange: modules.game_prey.onHover(self)

      $pressed:
        image-clip: 0 67 207 67

  UIButton
    id: temp
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 64
    margin-top: 7
    visible: false
    @onClick: modules.game_shop.show()

    UIWidget
      id: shopTempButton
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      image-source: /images/game/prey/prey_temp_test
      size: 195 67
      image-clip: 0 0 204 67
      @onClick: modules.game_shop.show()
      @onHoverChange: modules.game_prey.onHover(self)

      $pressed:
        image-clip: 0 67 204 67

