<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:fx="http://ns.adobe.com/mxml/2009"
        xmlns:s="library://ns.adobe.com/flex/spark"
        minWidth="180"
        minHeight="120">

    <fx:Metadata>
        <![CDATA[[HostComponent("spark.components.TitleWindow")]]]>
    </fx:Metadata>

    <s:states>
        <s:State name="normal"/>
        <s:State name="disabled"/>
        <s:State name="inactive"/>
        <s:State name="normalAndInactive"/>
        <s:State name="normalWithControlBar"/>
        <s:State name="disabledWithControlBar"/>
        <s:State name="inactiveWithControlBar"/>
    </s:states>

    <s:Rect left="0" right="0" top="0" bottom="0">
        <s:fill>
            <s:SolidColor color="0x3E4248"/>
        </s:fill>
        <s:stroke>
            <s:SolidColorStroke color="0x171A1F"/>
        </s:stroke>
    </s:Rect>

    <s:Rect left="1" right="1" top="1" height="25">
        <s:fill>
            <s:LinearGradient rotation="90">
                <s:GradientEntry color="0x4B5058"/>
                <s:GradientEntry color="0x34383E"/>
            </s:LinearGradient>
        </s:fill>
    </s:Rect>

    <s:Rect left="1" right="1" top="26" height="1">
        <s:fill>
            <s:SolidColor color="0x171A1F"/>
        </s:fill>
    </s:Rect>

    <s:Group id="moveArea" left="1" right="1" top="1" height="25"/>

    <s:Label id="titleDisplay"
             left="10"
             right="28"
             top="5"
             maxDisplayedLines="1"
             color="0xD9DEE5"
             fontWeight="bold"/>

    <s:Button id="closeButton"
              right="6"
              top="5"
              width="15"
              height="15"
              label="x"
              color="0xD9DEE5"
              chromeColor="0x4B5058"
              skinClass="spark.skins.spark.ButtonSkin"/>

    <s:Group id="contentGroup"
             left="1"
             right="1"
             top="27"
             bottom="1"/>
</s:Skin>
